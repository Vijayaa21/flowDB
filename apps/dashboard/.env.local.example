# Dashboard local auth setup
# Copy this file to .env.local and fill real values.

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Auth.js session secret (generate a long random string)
AUTH_SECRET=replace_with_long_random_secret

# Local app URL
NEXTAUTH_URL=http://localhost:3001

# Local orchestrator API
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3000
NEXT_PUBLIC_FLOWDB_ENVIRONMENT=local
NEXT_PUBLIC_FLOWDB_ORG_SLUG=local
NEXT_PUBLIC_FLOWDB_PROJECT_SLUG=flowdb
NEXT_PUBLIC_FLOWDB_SOURCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowdb
